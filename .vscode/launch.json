{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/server"
        },
        {
            // 先运行 air（它会用 dlv --headless 在 2345 端口启动），再启动这个配置
            "name": "Attach to Air",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 2345,
            "host": "127.0.0.1",
            // 文件改动后 air 会重启 dlv，需要重新按 F5 attach
            "showLog": false
        }
    ]
}